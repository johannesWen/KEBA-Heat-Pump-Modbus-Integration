{
  "name": "KEBA Home Assistant Development",
  "workspaceFolder": "/workspaces/keba",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt && npm --prefix frontend ci",
  "remoteUser": "vscode",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "devcontainer",
  "runServices": [
    "devcontainer",
    "homeassistant",
    "modbus-simulator"
  ],
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postStartCommand": "npm --prefix frontend run build && python dev/bootstrap.py",
  "waitFor": "postStartCommand"
}
